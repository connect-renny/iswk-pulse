# Normalise text files, keep LF in the repo
* text=auto eol=lf

*.html  text
*.css   text
*.scss  text
*.js    text
*.svg   text
*.py    text
*.md    text
*.map   text

# Binary assets — never touch
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.webp  binary
*.ico   binary
*.mp4   binary
*.mov   binary
*.mp3   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
